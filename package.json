{
  "name": "gas-dev-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Prettier, TypeScript and ESLint configuration for gas-* Google Apps Script projects.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-dev-config.git"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "type": "module",
  "files": [
    "bin",
    "eslint",
    "tsconfig",
    "prettier.json",
    "templates"
  ],
  "prettier": {
    "singleQuote": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^22.20.5",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && echo '✓ TypeScript passed'",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    "./prettier": "./prettier.json",
    "./tsconfig/*": "./tsconfig/*",
    "./package.json": "./package.json"
  }
}

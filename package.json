{
  "name": "gasdev",
  "version": "3.0.0",
  "private": true,
  "description": "Shared Prettier, TypeScript and ESLint configuration, plus release, bundle and deploy tooling, for gas-* Google Apps Script projects.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gasdev.git"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "bin": {
    "gasdev": "bin/gasdev.js"
  },
  "files": [
    "bin",
    "eslint",
    "gas-test",
    "src",
    "tsconfig",
    "prettier.json",
    "templates",
    "test-loader"
  ],
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@types/prompts": "^2.4.9",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prompts": "^2.4.2",
    "semver": "^7.8.5",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "@google/clasp": "^3.4.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "@google/clasp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@action-validator/cli": "^0.6.0",
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "gaxios": "^7.3.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && echo '✓ TypeScript passed'",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "lint:workflows": "action-validator .github/workflows/*.yml",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && node bin/gasdev.js check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:network": "GASDEV_NETWORK=1 vitest run test/peers.network.test.js"
  },
  "exports": {
    "./bundle": {
      "types": "./src/bundle/types.d.ts",
      "default": "./src/bundle/index.js"
    },
    "./ci": {
      "types": "./src/ci/types.d.ts",
      "default": "./src/ci/index.js"
    },
    "./eslint": "./eslint/index.js",
    "./gas-test": {
      "types": "./gas-test/runtime.d.ts",
      "default": "./gas-test/runtime.js"
    },
    "./gas-test/runtime.js": "./gas-test/runtime.js",
    "./prettier": "./prettier.json",
    "./test": {
      "types": "./test-loader/types.d.ts",
      "default": "./test-loader/index.js"
    },
    "./tsconfig/*": "./tsconfig/*",
    "./package.json": "./package.json"
  },
  "gasdev": {
    "preset": "node"
  }
}

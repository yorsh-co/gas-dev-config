{
  "name": "gas-dev-config",
  "version": "2.0.1",
  "private": true,
  "description": "Shared Prettier, TypeScript and ESLint configuration for gas-* Google Apps Script projects.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-dev-config.git"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "bin": {
    "gas-dev-config": "bin/gas-dev-config.js"
  },
  "files": [
    "bin",
    "eslint",
    "gas-test",
    "tsconfig",
    "prettier.json",
    "templates",
    "test-loader"
  ],
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "gas-dev-bundle": "github:yorsh-co/gas-dev-bundle#semver:^2.0.0",
    "globals": "^17.7.0",
    "semver": "^7.8.5",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "@google/clasp": "^3.4.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "@google/clasp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && echo '✓ TypeScript passed'",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && node bin/gas-dev-config.js check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:network": "GAS_DEV_CONFIG_NETWORK=1 vitest run test/peers.network.test.js"
  },
  "exports": {
    "./eslint": "./eslint/index.js",
    "./gas-test": {
      "types": "./gas-test/runtime.d.ts",
      "default": "./gas-test/runtime.js"
    },
    "./gas-test/runtime.js": "./gas-test/runtime.js",
    "./prettier": "./prettier.json",
    "./test": {
      "types": "./test-loader/types.d.ts",
      "default": "./test-loader/index.js"
    },
    "./tsconfig/*": "./tsconfig/*",
    "./package.json": "./package.json"
  },
  "gasDevConfig": {
    "preset": "node"
  }
}

{
  "compilerOptions": {
    // Environment. Apps Script's push-time parser rejects ES2021 syntax
    // (logical assignment, numeric separators), so it is downleveled; the
    // V8 runtime provides the ES2021 library.
    "target": "ES2020",
    "lib": ["ES2021"],
    "types": ["google-apps-script"],

    // Outputs
    "declaration": true,
    "noEmitOnError": true,

    // Stricter type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Module hygiene
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,

    // Compatibility
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}

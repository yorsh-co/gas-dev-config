{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // Type-check plain JavaScript (JSDoc); nothing is emitted.
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Stricter Typechecking Options
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "skipLibCheck": true
  },
  "include": ["bin/**/*.js", "eslint/**/*.js", "test/**/*.js"],
  "exclude": ["test/fixtures/**"]
}
